# Helder: add to configuration.yaml (merge with an existing `frontend:` block), then restart Home Assistant.
frontend:
  themes: !include_dir_merge_named themes
  extra_module_url:
    - /local/helder/helder.js

panel_custom:
  - name: helder-settings-panel
    sidebar_title: Helder
    sidebar_icon: mdi:palette-outline
    url_path: helder
    module_url: /local/helder/helder.js
    require_admin: true
