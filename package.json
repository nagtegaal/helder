{
  "name": "helder",
  "version": "0.1.0",
  "private": true,
  "description": "Helder: theme and card library for Home Assistant",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --config vite.dev.config.ts && mkdir -p dev-dist/fonts && cp dist/fonts/* dev-dist/fonts/",
    "build": "tsc --noEmit && vite build && tsx scripts/postbuild.ts",
    "theme": "tsx scripts/gen-theme.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@fontsource/hind": "5.3.0",
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
